{
  "name": "LLVM RISC Compiler",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "containerEnv": {
    "CCACHE_DIR": "/workspaces/.ccache"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "cmake.configureArgs": [
          "-DCMAKE_C_COMPILER_LAUNCHER=ccache",
          "-DCMAKE_CXX_COMPILER_LAUNCHER=ccache"
        ]
      },
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ]
    }
  },
  "postCreateCommand": "ccache --zero-stats && ccache --set-config=max_size=10G",
  "postStartCommand": "ccache --show-stats",
  "remoteUser": "vscode"
}
